# KhmerDub AI Configuration

# Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Application
APP_NAME=KhmerDub AI
APP_VERSION=0.1.0

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Paths
DATA_DIR=/app/data
UPLOADS_DIR=/app/data/uploads
OUTPUTS_DIR=/app/data/outputs
TEMP_DIR=/app/data/temp
DATABASE_URL=sqlite:////app/data/khmerdub.db

# AI & Processing
MODEL_CACHE_DIR=/root/.cache
WHISPER_MODEL=base
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true

# Translation (NLLB-200)
TRANSLATION_PROVIDER=nllb
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_SOURCE_LANG=eng_Latn
TRANSLATION_TARGET_LANG=khm_Khmr
TRANSLATION_DEVICE=cpu
TRANSLATION_BATCH_SIZE=1
TRANSLATION_NUM_BEAMS=2
TRANSLATION_MAX_INPUT_TOKENS=512

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=500
