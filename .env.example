# KhmerDub AI Configuration

# Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Application
APP_NAME=KhmerDub AI
APP_VERSION=0.1.0

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Paths
DATA_DIR=/app/data
UPLOADS_DIR=/app/data/uploads
OUTPUTS_DIR=/app/data/outputs
TEMP_DIR=/app/data/temp
DATABASE_URL=sqlite:////app/data/khmerdub.db

# AI & Processing
MODEL_CACHE_DIR=/root/.cache
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=500
