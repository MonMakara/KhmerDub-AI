# Optional evaluated cleanup image, layered over the ordinary backend build.
# Application Python and its AI packages remain unchanged.
FROM khmerdub-ai-backend
RUN python -m venv /opt/audio-cleaning-env \
    && /opt/audio-cleaning-env/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.0.1+cpu torchaudio==2.0.2+cpu \
    && /opt/audio-cleaning-env/bin/pip install --no-cache-dir 'numpy<2' 'soundfile>=0.12,<0.14' demucs==4.0.1
